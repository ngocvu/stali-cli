{
  "name": "stali-cli",
  "version": "3.42.0",
  "description": "Interactive CLI tool and configuration manager for Stali API (https://api.stali.vn)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "stali": "./bin/stali.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/ONBOARDING.md",
    "scripts/npm-postinstall.cjs"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "build": "bun scripts/build.ts",
    "postinstall": "node scripts/npm-postinstall.cjs",
    "pack:cli": "bun run build && npm pack",
    "verify:pack": "bun run build && bun scripts/verify-npm-pack.ts",
    "publish:cli": "bun run build && npm publish",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "bun test",
    "bench": "bun run build && bun scripts/benchmark-cold-start.ts",
    "bench:setup": "bun run build && bun scripts/benchmark-setup.ts",
    "bench:wizard": "bun run build && bun scripts/benchmark-wizard.ts",
    "test:e2e:live": "bun run build && bun scripts/e2e-live.ts",
    "analyze": "bun run build && bun scripts/analyze-bundle.ts"
  },
  "keywords": [
    "stali",
    "cli",
    "ai",
    "claude",
    "codex",
    "deepseek",
    "llm",
    "ink",
    "bun"
  ],
  "author": "KietNT",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ngocvu/stali-cli.git"
  },
  "homepage": "https://api.stali.vn/docs",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "chalk": "^6.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "confbox": "^0.2.4",
    "ink": "^7.1.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8",
    "react-devtools-core": "file:./scripts/stubs/react-devtools-core-pkg",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "funding": false
}
