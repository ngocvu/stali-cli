#!/usr/bin/env bash
# Portable stali launcher — Node (npm) hoặc Bun.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENTRY="$ROOT/dist/index.js"

if [[ ! -f "$ENTRY" ]]; then
  echo "stali-cli: missing $ENTRY — run: bun run build" >&2
  exit 1
fi

if [[ -n "${NODE_BIN:-}" && -x "${NODE_BIN}" ]]; then
  exec "$NODE_BIN" "$ENTRY" "$@"
fi

if command -v node >/dev/null 2>&1; then
  exec node "$ENTRY" "$@"
fi

if [[ -n "${BUN_BIN:-}" && -x "${BUN_BIN}" ]]; then
  exec "$BUN_BIN" "$ENTRY" "$@"
fi

if command -v bun >/dev/null 2>&1; then
  exec bun "$ENTRY" "$@"
fi

if [[ -x "$HOME/.bun/bin/bun" ]]; then
  exec "$HOME/.bun/bin/bun" "$ENTRY" "$@"
fi

echo "stali-cli: Node (>=18) hoặc Bun runtime not found." >&2
exit 1
